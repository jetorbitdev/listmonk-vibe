{
  "name": "listmonk-mcp",
  "version": "0.1.0",
  "description": "MCP server for listmonk: subscribers, lists, campaigns, templates, transactional mail and a generic API passthrough.",
  "type": "module",
  "bin": {
    "listmonk-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
