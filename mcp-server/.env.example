# Base URL of your listmonk instance (no trailing slash)
LISTMONK_URL=http://localhost:9000
# API user + token created in listmonk Admin -> Users (type: API)
LISTMONK_API_USER=api_user
LISTMONK_API_TOKEN=your_token_here
# Optional: request timeout in milliseconds (default 30000)
# LISTMONK_TIMEOUT_MS=30000
